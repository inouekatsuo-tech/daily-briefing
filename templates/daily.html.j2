<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Daily Briefing — {{ date_str }}</title>
  <style>
    /* ── CSS 変数（ライト / ダーク自動切替）── */
    :root {
      --bg:           #f8f9fa;
      --surface:      #ffffff;
      --surface2:     #f1f3f5;
      --text:         #212529;
      --muted:        #6c757d;
      --border:       #dee2e6;
      --accent:       #4361ee;
      --accent-light: #e8ecfb;
      --green:        #2dc653;
      --amber:        #f4a261;
      --gray:         #adb5bd;
      --radius:       10px;
      --shadow:       0 1px 3px rgba(0,0,0,.08);
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --bg:           #0f1117;
        --surface:      #1a1d27;
        --surface2:     #22263a;
        --text:         #e9ecef;
        --muted:        #868e96;
        --border:       #2d3143;
        --accent-light: #1e2340;
      }
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: -apple-system, BlinkMacSystemFont, 'Hiragino Sans', 'Yu Gothic UI',
                   'Segoe UI', sans-serif;
      font-size: 15px;
      line-height: 1.7;
    }

    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; }

    /* ── レイアウト ── */
    .container {
      max-width: 780px;
      margin: 0 auto;
      padding: 2rem 1.25rem 4rem;
    }

    /* ── ヘッダー ── */
    header {
      margin-bottom: 2.5rem;
    }
    .nav {
      font-size: 0.83rem;
      color: var(--muted);
      margin-bottom: 1rem;
    }
    .nav a { color: var(--muted); }
    .nav a:hover { color: var(--accent); }
    header h1 {
      font-size: 1.6rem;
      font-weight: 800;
      letter-spacing: -0.02em;
    }
    .date-badge {
      display: inline-block;
      margin-top: 0.4rem;
      background: var(--accent-light);
      color: var(--accent);
      font-size: 0.8rem;
      font-weight: 600;
      padding: 0.2rem 0.75rem;
      border-radius: 9999px;
    }

    /* ── カテゴリセクション ── */
    .category {
      margin-bottom: 3rem;
    }
    .category-header {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 1.1rem;
      font-weight: 700;
      margin-bottom: 1rem;
      padding-bottom: 0.6rem;
      border-bottom: 2px solid var(--border);
    }
    .category-count {
      font-size: 0.75rem;
      font-weight: 500;
      color: var(--muted);
      background: var(--surface2);
      padding: 0.15rem 0.55rem;
      border-radius: 9999px;
      margin-left: auto;
    }

    /* ── 記事カード ── */
    .article {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1rem 1.1rem;
      margin-bottom: 0.75rem;
      box-shadow: var(--shadow);
      transition: border-color .15s;
    }
    .article:hover { border-color: var(--accent); }

    .article-meta {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-bottom: 0.45rem;
    }

    /* スコアバッジ */
    .score-badge {
      font-size: 0.72rem;
      font-weight: 700;
      padding: 0.15rem 0.55rem;
      border-radius: 9999px;
      color: #fff;
      white-space: nowrap;
    }
    .score-high { background: var(--green); }
    .score-mid  { background: var(--amber); }
    .score-low  { background: var(--gray);  }

    .source-tag {
      font-size: 0.72rem;
      color: var(--muted);
      background: var(--surface2);
      padding: 0.15rem 0.55rem;
      border-radius: 9999px;
    }

    /* タイトル */
    .article-title {
      font-size: 0.97rem;
      font-weight: 600;
      line-height: 1.45;
      margin-bottom: 0.45rem;
    }
    .article-title a { color: var(--text); }
    .article-title a:hover { color: var(--accent); text-decoration: none; }

    /* 要約 */
    .article-summary {
      font-size: 0.88rem;
      color: var(--muted);
      margin-bottom: 0.3rem;
      line-height: 1.6;
    }

    /* スコア理由 */
    .score-reason {
      font-size: 0.78rem;
      color: var(--muted);
      opacity: .75;
      font-style: italic;
    }

    /* 空状態 */
    .empty {
      color: var(--muted);
      font-size: 0.88rem;
      padding: 1rem;
      background: var(--surface2);
      border-radius: var(--radius);
      text-align: center;
    }

    /* ── フッター ── */
    footer {
      margin-top: 3rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--border);
      text-align: center;
      font-size: 0.8rem;
      color: var(--muted);
      line-height: 2;
    }
  </style>
</head>
<body>
<div class="container">

  <header>
    <div class="nav">
      <a href="../index.html">← アーカイブ一覧</a>
    </div>
    <h1>📋 デイリーブリーフィング</h1>
    <span class="date-badge">{{ date_str }}</span>
  </header>

  {% for cat in categories %}
  <section class="category">
    <div class="category-header">
      <span>{{ cat.emoji }} {{ cat.name }}</span>
      <span class="category-count">{{ cat.articles | length }} 件</span>
    </div>

    {% if cat.articles %}
      {% for article in cat.articles %}
      <div class="article">
        <div class="article-meta">
          {%- set s = article.score -%}
          <span class="score-badge {% if s >= 7.5 %}score-high{% elif s >= 4.5 %}score-mid{% else %}score-low{% endif %}">
            ★ {{ "%.1f" | format(s) }}
          </span>
          <span class="source-tag">{{ article.source_name }}</span>
        </div>

        <div class="article-title">
          <a href="{{ article.url }}" target="_blank" rel="noopener noreferrer">
            {{ article.title }}
          </a>
        </div>

        {% if article.summary %}
        <div class="article-summary">{{ article.summary }}</div>
        {% endif %}

        {% if article.score_reason %}
        <div class="score-reason">💡 {{ article.score_reason }}</div>
        {% endif %}
      </div>
      {% endfor %}
    {% else %}
      <div class="empty">本日は記事を取得できませんでした。</div>
    {% endif %}
  </section>
  {% endfor %}

  <footer>
    Generated by Daily Briefing System &times; Claude Haiku<br>
    <a href="../index.html">← アーカイブ一覧に戻る</a>
  </footer>

</div>
</body>
</html>
